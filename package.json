    "submenus": [
      {
        "id": "dynamics365Tools.resourceMenu",
        "label": "Dynamics 365 Tools"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "dynamics365Tools.resourceMenu",
          "group": "navigation@dynamics365Tools",
          "when": "resourceScheme == 'file' && (explorerResourceIsFolder || resourceExtname =~ /\\.(js|css|html|htm|xml|json|resx|png|jpg|jpeg|gif|xsl|xslt|ico|svg)$/)"
        },
        {
          "command": "dynamics365Tools.pcf.build",
          "group": "navigation@dynamics365ToolsPcf",
          "when": "resourceScheme == 'file' && resourceFilename == 'ControlManifest.Input.xml'"
        },
        {
          "command": "dynamics365Tools.pcf.watch",
          "group": "navigation@dynamics365ToolsPcf",
          "when": "resourceScheme == 'file' && resourceFilename == 'ControlManifest.Input.xml'"
        },
        {
          "command": "dynamics365Tools.pcf.push",
          "group": "navigation@dynamics365ToolsPcf",
          "when": "resourceScheme == 'file' && resourceFilename == 'ControlManifest.Input.xml'"
        },
        {
          "command": "dynamics365Tools.pcf.packageManaged",
          "group": "navigation@dynamics365ToolsPcf",
          "when": "resourceScheme == 'file' && resourceFilename == 'ControlManifest.Input.xml'"
        },
        {
          "command": "dynamics365Tools.pcf.packageUnmanaged",
          "group": "navigation@dynamics365ToolsPcf",
          "when": "resourceScheme == 'file' && resourceFilename == 'ControlManifest.Input.xml'"
        },
        {
          "command": "dynamics365Tools.pcf.deployLast",
          "group": "navigation@dynamics365ToolsPcf",
          "when": "resourceScheme == 'file' && resourceFilename == 'ControlManifest.Input.xml'"
        }
      ],
      "dynamics365Tools.resourceMenu": [
        {
          "command": "dynamics365Tools.publishResource",
