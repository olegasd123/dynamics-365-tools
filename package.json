      "view/title": [
        {
          "command": "dynamics365Tools.configureEnvironments",
          "when": "view == dynamics365Tools.pluginExplorer",
          "group": "navigation@1"
        },
        {
          "command": "dynamics365Tools.plugins.disableSolutionFilter",
          "when": "view == dynamics365Tools.pluginExplorer && d365Tools.plugins.filterConfiguredSolutions",
          "group": "navigation@2",
          "toggled": "d365Tools.plugins.filterConfiguredSolutions"
        },
        {
          "command": "dynamics365Tools.plugins.enableSolutionFilter",
          "when": "view == dynamics365Tools.pluginExplorer && !d365Tools.plugins.filterConfiguredSolutions",
          "group": "navigation@2",
          "toggled": "d365Tools.plugins.filterConfiguredSolutions"
        },
        {
          "command": "dynamics365Tools.plugins.refreshExplorer",
          "when": "view == dynamics365Tools.pluginExplorer",
          "group": "navigation@3"
        },
        {
          "command": "dynamics365Tools.plugins.registerAssembly",
          "when": "view == dynamics365Tools.pluginExplorer",
          "group": "navigation@4"
        },
        {
          "command": "dynamics365Tools.pcf.refreshExplorer",
          "when": "view == dynamics365Tools.pcfExplorer",
          "group": "navigation@2"
        },
        {
          "command": "dynamics365Tools.pcf.disableSolutionFilter",
          "when": "view == dynamics365Tools.pcfExplorer && d365Tools.pcf.filterConfiguredSolutions",
          "group": "navigation@3",
          "toggled": "d365Tools.pcf.filterConfiguredSolutions"
        },
        {
          "command": "dynamics365Tools.pcf.enableSolutionFilter",
          "when": "view == dynamics365Tools.pcfExplorer && !d365Tools.pcf.filterConfiguredSolutions",
          "group": "navigation@3",
          "toggled": "d365Tools.pcf.filterConfiguredSolutions"
        },
        {
          "command": "dynamics365Tools.pcf.newControl",
          "when": "view == dynamics365Tools.pcfExplorer",
          "group": "navigation@1"
        },
        {
          "command": "dynamics365Tools.pcf.setWorkspaceFolderFilter",
          "when": "view == dynamics365Tools.pcfExplorer",
          "group": "navigation@4"
        },
